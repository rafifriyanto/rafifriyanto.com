# Cloudflare Pages / Netlify read this file and apply these headers to every
# response. Nothing here is optional for a site on your own domain.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Everything the page needs is served from this origin — fonts included, since
  # they are bundled rather than pulled from Google. The one loosening is
  # 'unsafe-inline' on scripts: Astro inlines the few small scripts this site
  # uses, and a static headers file cannot carry per-request nonces. External
  # scripts are still blocked outright, which is the attack this actually stops.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Hashed build assets never change under the same name — cache them hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
