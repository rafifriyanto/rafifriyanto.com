<!doctype html>
<html><head><meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap">
<style>
  *{box-sizing:border-box;margin:0}
  html,body{width:1500px;height:500px;overflow:hidden}
  body{
    position:relative;
    background:#171310;
    font-family:'Space Grotesk',sans-serif;
    color:#F7F4F0;
  }
  /* Same atmosphere as the site: engineering grid + copper glow. */
  .grid{
    position:absolute;inset:0;
    background-image:
      linear-gradient(to right,rgba(255,255,255,.030) 1px,transparent 1px),
      linear-gradient(to bottom,rgba(255,255,255,.030) 1px,transparent 1px);
    background-size:76px 76px;
    -webkit-mask-image:radial-gradient(ellipse 80% 120% at 70% 0%,#000 20%,transparent 80%);
  }
  .glow{
    position:absolute;inset:0;
    background:
      radial-gradient(46rem 24rem at 50% -25%,rgba(240,168,96,.20),transparent 62%),
      radial-gradient(30rem 18rem at 12% 110%,rgba(200,120,60,.10),transparent 65%);
  }
  /* The avatar overlaps the lower-left on LinkedIn, so nothing lives there. */
  .content{
    position:absolute;
    left:60px;right:60px;align-items:center;text-align:center;top:0;bottom:0;
    display:flex;flex-direction:column;justify-content:center;
    gap:22px;
    padding-bottom:26px;
  }
  .eyebrow{
    display:flex;align-items:center;gap:14px;
    font-family:'JetBrains Mono',monospace;
    font-size:14px;font-weight:500;letter-spacing:.30em;text-transform:uppercase;
    color:#F0A860;
  }
  .eyebrow::before{content:'';width:34px;height:1px;background:currentColor;opacity:.65}
  h1{
    font-size:56px;font-weight:500;line-height:1.08;letter-spacing:-.025em;
    max-width:20ch;
  }
  h1 em{font-family:'Instrument Serif',serif;font-style:italic;font-weight:400;color:#F0A860}
  .rule{width:min(560px,80%);height:1px;background:linear-gradient(to right,rgba(255,255,255,.22),transparent)}
  .foot{
    display:flex;align-items:center;gap:26px;
    font-family:'JetBrains Mono',monospace;
    font-size:14px;letter-spacing:.14em;text-transform:uppercase;
    color:#9AA39C;
  }
  .dot{width:5px;height:5px;background:#F0A860;transform:rotate(45deg)}
</style></head>
<body>
  <div class="grid"></div><div class="glow"></div>
  <div class="content">
    <p class="eyebrow">Medical student &middot; Automation</p>
    <h1>The work that <em>shouldn&rsquo;t</em> be done by hand.</h1>
    <div class="rule"></div>
    <p class="foot">
      <span>Bots</span><span class="dot"></span>
      <span>Scrapers</span><span class="dot"></span>
      <span>AI workflows</span>
    </p>
  </div>
</body></html>
