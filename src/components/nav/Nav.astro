---
import { SITE, type Locale } from '../../config';
import { withBase } from '../../lib/url';
import type { Dict } from '../../i18n';

interface Props {
  locale: Locale;
  t: Dict;
}

const { locale, t } = Astro.props;
const contactHref = '#contact';
---

<header class="nav" data-nav>
  <div class="nav__inner shell">
    <a class="wordmark" href={withBase(locale === 'id' ? '/' : '/en/')} aria-label={SITE.name}>
      <span class="wordmark__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M8.5 6.5 3.5 12l5 5.5M15.5 6.5l5 5.5-5 5.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="wordmark__text">{SITE.wordmark}</span>
    </a>

    <nav class="nav__links" aria-label={locale === 'id' ? 'Navigasi utama' : 'Main navigation'}>
      {t.nav.links.map((link) => (
        <a class="nav__link" href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="nav__end">
      <div class="lang" role="group" aria-label={t.nav.langLabel}>
        <a class:list={['lang__opt', locale === 'id' && 'is-active']} href={withBase('/')} hreflang="id" aria-current={locale === 'id' ? 'true' : undefined}>ID</a>
        <span class="lang__sep" aria-hidden="true">/</span>
        <a class:list={['lang__opt', locale === 'en' && 'is-active']} href={withBase('/en/')} hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
      </div>

      <a class="btn nav__cta" href={contactHref}>
        {t.nav.cta}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>

      <button
        class="nav__toggle"
        type="button"
        data-nav-toggle
        data-close-label={t.nav.menuClose}
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <span class="visually-hidden" data-nav-toggle-label>{t.nav.menuOpen}</span>
        <span class="nav__burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="nav__drawer" id="nav-drawer" data-nav-drawer hidden>
    <nav class="nav__drawer-links" aria-label={locale === 'id' ? 'Navigasi seluler' : 'Mobile navigation'}>
      {t.nav.links.map((link) => (
        <a class="nav__drawer-link" href={link.href} data-nav-close>{link.label}</a>
      ))}
      <a class="nav__drawer-link nav__drawer-link--cta" href={contactHref} data-nav-close>{t.nav.cta}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-normal) var(--ease-out-quart),
      border-color var(--dur-normal) var(--ease-out-quart);
  }

  .nav[data-scrolled='true'] {
    background: oklch(13.5% 0.012 62 / 0.82);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    height: 4.75rem;
  }

  /* --- wordmark --- */

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .wordmark__mark {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-sm);
    color: var(--copper);
    transition:
      border-color var(--dur-fast) linear,
      transform var(--dur-normal) var(--ease-out-expo);
  }

  .wordmark__mark svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .wordmark:hover .wordmark__mark {
    border-color: var(--copper);
    transform: rotate(-90deg);
  }

  .wordmark__text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    color: var(--text-hi);
  }

  /* --- desktop links --- */

  .nav__links {
    display: none;
    gap: clamp(1.25rem, 2.4vw, 2.4rem);
  }

  .nav__link {
    position: relative;
    padding-block: 0.4rem;
    font-size: var(--text-sm);
    color: var(--text-mid);
    transition: color var(--dur-fast) linear;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--copper);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }

  .nav__link:hover {
    color: var(--text-hi);
  }

  .nav__link:hover::after {
    transform: scaleX(1);
  }

  /* --- end cluster --- */

  .nav__end {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .lang {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
  }

  .lang__opt {
    color: var(--text-lo);
    transition: color var(--dur-fast) linear;
  }

  .lang__opt:hover {
    color: var(--text-hi);
  }

  .lang__opt.is-active {
    color: var(--copper);
  }

  .lang__sep {
    color: var(--text-lo);
    opacity: 0.5;
  }

  .nav__cta {
    display: none;
    padding: 0.7rem 1.15rem;
  }

  /* --- burger --- */

  .nav__toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-sm);
    background: transparent;
    cursor: pointer;
  }

  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: var(--text-hi);
    transition: transform var(--dur-normal) var(--ease-out-expo), opacity var(--dur-fast) linear;
  }

  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
  }

  .nav__burger::before {
    transform: translateY(-5px);
  }

  .nav__burger::after {
    transform: translateY(5px);
  }

  .nav__toggle[aria-expanded='true'] .nav__burger {
    background: transparent;
  }

  .nav__toggle[aria-expanded='true'] .nav__burger::before {
    transform: rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__burger::after {
    transform: rotate(-45deg);
  }

  /* --- drawer --- */

  .nav__drawer {
    border-top: 1px solid var(--line);
    background: oklch(13.5% 0.012 62 / 0.96);
    backdrop-filter: blur(16px);
  }

  .nav__drawer[hidden] {
    display: none;
  }

  .nav__drawer-links {
    display: grid;
    padding: var(--space-4) var(--gutter) var(--space-8);
  }

  .nav__drawer-link {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-lg);
    color: var(--text-hi);
  }

  .nav__drawer-link--cta {
    border-bottom: 0;
    margin-top: var(--space-4);
    color: var(--copper);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (min-width: 62rem) {
    .nav__links,
    .lang,
    .nav__cta {
      display: flex;
    }

    .nav__toggle {
      display: none;
    }

    .nav__drawer {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
  const label = document.querySelector<HTMLElement>('[data-nav-toggle-label]');

  // Solid background only once the page has actually moved.
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
    document.body.prepend(sentinel);
    new IntersectionObserver(
      ([entry]) => header.setAttribute('data-scrolled', String(!entry.isIntersecting)),
      { threshold: 0 },
    ).observe(sentinel);
  }

  if (toggle && drawer && label) {
    const openText = label.textContent ?? '';
    const closeText = toggle.dataset.closeLabel ?? openText;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      drawer.hidden = !open;
      label.textContent = open ? closeText : openText;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    drawer.querySelectorAll('[data-nav-close]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
