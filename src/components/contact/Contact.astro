---
import { CONTACT, FORM_ENDPOINT } from '../../config';
import type { Dict } from '../../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const f = t.contact.form;
const waHref = `https://wa.me/${CONTACT.whatsapp}`;
---

<section id="contact" aria-labelledby="contact-title">
  <div class="shell contact">
    <div class="contact__intro reveal">
      <p class="section-index">
        <span class="section-index__no">06</span>
        <span class="section-index__label">{t.contact.eyebrow}</span>
      </p>
      <h2 class="section-title contact__title" id="contact-title">{t.contact.title}</h2>
      <p class="section-lede">{t.contact.lede}</p>

      <p class="contact__direct-label">{t.contact.directLabel}</p>
      <ul class="direct">
        <li>
          <a class="direct__link" href={`mailto:${CONTACT.email}`}>
            <span class="direct__key">email</span>
            <span class="direct__val">{CONTACT.email}</span>
          </a>
        </li>
        <li>
          <a class="direct__link" href={waHref} target="_blank" rel="noopener noreferrer">
            <span class="direct__key">whatsapp</span>
            <span class="direct__val">{CONTACT.whatsappDisplay}</span>
          </a>
        </li>
      </ul>
    </div>

    <form
      class="form reveal"
      data-contact-form
      action={FORM_ENDPOINT || undefined}
      method="post"
      data-fallback-email={CONTACT.email}
    >
      <div class="form__row">
        <label class="input">
          <span class="input__label">{f.name} <em class="input__flag">{f.required}</em></span>
          <input class="input__control" type="text" name="name" required autocomplete="name" />
        </label>

        <label class="input">
          <span class="input__label">{f.email} <em class="input__flag">{f.required}</em></span>
          <input class="input__control" type="email" name="email" required autocomplete="email" />
        </label>
      </div>

      <div class="form__row">
        <label class="input">
          <span class="input__label">{f.company} <em class="input__flag">{f.optional}</em></span>
          <input class="input__control" type="text" name="company" autocomplete="organization" />
        </label>

        <label class="input">
          <span class="input__label">{f.budget} <em class="input__flag">{f.optional}</em></span>
          <select class="input__control" name="budget">
            {f.budgetOptions.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </label>
      </div>

      <label class="input">
        <span class="input__label">{f.message} <em class="input__flag">{f.required}</em></span>
        <textarea
          class="input__control input__control--area"
          name="message"
          rows="5"
          required
          placeholder={f.messagePlaceholder}></textarea>
      </label>

      <p class="form__consent">{f.consent}</p>

      <button class="btn form__submit" type="submit" data-submit data-sending={f.sending}>
        <span data-submit-label>{f.submit}</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>

      <p class="form__status" role="status" data-status data-success={f.success} data-error={f.error}></p>
    </form>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .contact__title {
    margin-block: var(--space-4);
  }

  .contact__direct-label {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-lo);
  }

  .direct {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .direct__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    transition: color var(--dur-fast) linear;
  }

  .direct__key {
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-lo);
  }

  .direct__val {
    color: var(--text-hi);
    overflow-wrap: anywhere;
  }

  .direct__link:hover .direct__val {
    color: var(--copper);
  }

  /* --- form --- */

  .form {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--line-mid);
    border-radius: var(--r-lg);
    background: linear-gradient(165deg, oklch(18% 0.013 62 / 0.75), oklch(13.5% 0.012 62 / 0.6));
  }

  .form__row {
    display: grid;
    gap: var(--space-4);
  }

  .input {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .input__label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-mid);
  }

  .input__flag {
    font-style: normal;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--text-lo);
  }

  .input__control {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-md);
    background: oklch(11% 0.01 62 / 0.6);
    color: var(--text-hi);
    font-size: var(--text-sm);
    transition:
      border-color var(--dur-fast) linear,
      background-color var(--dur-fast) linear;
  }

  .input__control::placeholder {
    color: var(--text-lo);
    opacity: 0.65;
  }

  .input__control:hover {
    border-color: var(--line-strong);
  }

  .input__control:focus {
    border-color: var(--copper);
    background: oklch(11% 0.01 62 / 0.9);
  }

  .input__control--area {
    resize: vertical;
    min-height: 8rem;
    line-height: 1.55;
  }

  .form__consent {
    font-size: var(--text-xs);
    color: var(--text-lo);
  }

  .form__submit {
    justify-content: center;
  }

  .form__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .form__status {
    min-height: 1.2em;
    font-size: var(--text-sm);
  }

  .form__status[data-state='success'] {
    color: var(--jade);
  }

  .form__status[data-state='error'] {
    color: var(--rose);
  }

  @media (min-width: 40rem) {
    .form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .contact {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    const endpoint = form.getAttribute('action');
    const fallbackEmail = form.dataset.fallbackEmail ?? '';

    /**
     * With no endpoint configured the form degrades to the user's mail client
     * rather than silently swallowing the message.
     */
    const openMailFallback = () => {
      const data = new FormData(form);
      const subject = encodeURIComponent(`Project enquiry — ${data.get('name') ?? ''}`);
      const body = encodeURIComponent(
        [
          `Name: ${data.get('name') ?? ''}`,
          `Email: ${data.get('email') ?? ''}`,
          `Company: ${data.get('company') ?? ''}`,
          `Budget: ${data.get('budget') ?? ''}`,
          '',
          String(data.get('message') ?? ''),
        ].join('\n'),
      );
      window.location.href = `mailto:${fallbackEmail}?subject=${subject}&body=${body}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      if (!endpoint) {
        openMailFallback();
        return;
      }

      const idleLabel = label?.textContent ?? '';
      if (button) button.disabled = true;
      if (label && button?.dataset.sending) label.textContent = button.dataset.sending;
      if (status) {
        status.textContent = '';
        status.removeAttribute('data-state');
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error(`Request failed: ${response.status}`);

        form.reset();
        if (status) {
          status.textContent = status.dataset.success ?? '';
          status.dataset.state = 'success';
        }
      } catch (error) {
        console.error('[contact] submission failed', error);
        if (status) {
          status.textContent = status.dataset.error ?? '';
          status.dataset.state = 'error';
        }
      } finally {
        if (button) button.disabled = false;
        if (label) label.textContent = idleLabel;
      }
    });
  }
</script>
