---
import { SITE, CONTACT, type Locale } from '../../config';
import { withBase } from '../../lib/url';
import type { Dict } from '../../i18n';

interface Props {
  locale: Locale;
  t: Dict;
}

const { locale, t } = Astro.props;
const year = new Date().getFullYear();
const waHref = `https://wa.me/${CONTACT.whatsapp}`;
---

<footer class="foot">
  <div class="shell foot__inner">
    <div class="foot__brand">
      <a class="foot__wordmark" href={withBase(locale === 'id' ? '/' : '/en/')}>{SITE.wordmark}</a>
      <p class="foot__tagline">{t.footer.tagline}</p>
    </div>

    <nav class="foot__col" aria-label={t.footer.navLabel}>
      <h2 class="foot__label">{t.footer.navLabel}</h2>
      <ul class="foot__list">
        {t.nav.links.map((link) => (
          <li><a class="foot__link" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="foot__col">
      <h2 class="foot__label">{t.footer.contactLabel}</h2>
      <ul class="foot__list">
        <li><a class="foot__link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        <li><a class="foot__link" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
      </ul>
    </div>

    <div class="foot__col">
      <h2 class="foot__label">{t.footer.socialLabel}</h2>
      <ul class="foot__list">
        <li><a class="foot__link" href={CONTACT.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a class="foot__link" href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li>
          <a class="foot__link" href={withBase(locale === 'id' ? '/en/' : '/')}>
            {locale === 'id' ? 'English' : 'Bahasa Indonesia'}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="shell foot__base">
    <p>© {year} {SITE.name}. {t.footer.rights}.</p>
    <p>{t.footer.built}</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }

  .foot__inner {
    display: grid;
    gap: var(--space-8);
  }

  .foot__wordmark {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    color: var(--text-hi);
  }

  .foot__tagline {
    max-width: 32ch;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-lo);
  }

  .foot__label {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--copper);
  }

  .foot__list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__link {
    font-size: var(--text-sm);
    color: var(--text-lo);
    transition: color var(--dur-fast) linear;
    overflow-wrap: anywhere;
  }

  .foot__link:hover {
    color: var(--text-hi);
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.05em;
    color: var(--text-lo);
  }

  @media (min-width: 48rem) {
    .foot__inner {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
</style>
